# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local (il est ignoré par git).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : utilisée seulement côté serveur par les crons
SUPABASE_SERVICE_ROLE_KEY=

# --- Accès : seule cette adresse peut se connecter ---
ALLOWED_EMAIL=vous@exemple.com
# Optionnel : URL publique du site (sinon déduite automatiquement)
# NEXT_PUBLIC_SITE_URL=https://conseiller-financier.vercel.app

# --- Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Resend (resend.com → API Keys) ---
RESEND_API_KEY=
ALERT_EMAIL_TO=vous@exemple.com
ALERT_EMAIL_FROM=Conseiller Financier <onboarding@resend.dev>

# --- Crons Vercel : longue chaîne aléatoire (ex. openssl rand -hex 32) ---
CRON_SECRET=

# --- Paramètres ---
APP_TIMEZONE=Europe/Paris
